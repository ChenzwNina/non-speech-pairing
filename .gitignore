__pycache__/
*.pyc
.DS_Store
.env

# v6 keeps both halves of its audio in git, because git is how they travel. The per-turn takes
# in v6/out/audio_turns/ go up from wherever ElevenLabs was called; the machine that assembles
# them pulls those, sews the conversations, and pushes v6/out/audio/ back. Neither is derived
# from the other in a way that makes it disposable — the takes cannot be regenerated identically
# and the conversations are what the evaluation actually plays.
#
# What is not kept is make_audio.py's own rough assembly. It hard-cuts the takes with a fixed
# gap and exists only so a render can be eyeballed locally; the aligned version replaces it
# under the same filenames, so keeping both would make provenance unreadable.
v6/out/audio_local_check/

# Intermediate TTS. Keep sewn eval clips in git; leave per-turn / voc / versioned renders local.
**/audio_neutral/
**/audio_voc/
**/audio_v1/
**/audio_v2/
prior_test/pairing_type/out/audio/
prior_test/predicting_content/out/audio_turns/
prior_test/transcript_curated/out/audio_turns/
prior_test/predicting_response/out/audio_turns/
prior_test/predicting_response/out/themes/audio_turns/
**/*-turn[0-9][0-9].mp3

# Third-party source corpus, 17MB. Only used once, to sample the 20 situations now
# recorded in laughter_sigh_contrast_v3/1.0/out/seeds.json. Refetch from facebookresearch/EmpatheticDialogues.
archive/train.csv

# Run logs; the manifests and verdicts they produce are what matters.
**/out/*.log
