{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v6 judge output contracts",
  "description": "The four response shapes of section 7. Confidence is optional for scoring but must be in range when present. Scores are integers 1-5; anything else is a parse failure, not a clamped value.",
  "$defs": {
    "mc_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_option"
      ],
      "properties": {
        "selected_option": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "description": "Perception is a five-way choice: the four vocalizations plus `none`. Every question carries every label, so there are no distractors to balance — only the order, and where the correct answer falls."
    },
    "content_absolute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "rationale",
        "unjudgeable"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "unjudgeable": {
          "type": "boolean"
        }
      }
    },
    "content_pairwise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred_response",
        "confidence",
        "rationale"
      ],
      "properties": {
        "preferred_response": {
          "type": "string",
          "enum": [
            "A",
            "B"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tone_absolute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "rationale",
        "unjudgeable",
        "unjudgeable_reason"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "unjudgeable": {
          "type": "boolean"
        },
        "unjudgeable_reason": {
          "type": "string"
        }
      }
    },
    "interpretation_match": {
      "type": "object",
      "additionalProperties": false,
      "description": "Whether a model's own account of the vocalization matches any acceptable interpretation. Three judges answer; two agreeing carries the item. interpretation_index is 0 when nothing matched.",
      "required": [
        "matched",
        "interpretation_index",
        "rationale"
      ],
      "properties": {
        "matched": {
          "type": "boolean"
        },
        "interpretation_index": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "content_match": {
      "type": "object",
      "additionalProperties": false,
      "description": "How well a reply follows from whichever acceptable reading it fits best. Scored against the best-fitting guide rather than a fixed one, so a model holding a defensible minority reading is judged on whether its reply follows from that reading instead of against the majority one.",
      "required": [
        "score",
        "best_guide_index",
        "rationale",
        "unjudgeable"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "best_guide_index": {
          "type": "integer",
          "enum": [
            1,
            2,
            3
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "unjudgeable": {
          "type": "boolean"
        }
      }
    },
    "tone_judgement": {
      "type": "object",
      "additionalProperties": false,
      "description": "Whether any clearly-wrong tone is audible in the reply. Negative by design: there is no single correct delivery, so a judge is asked what it hears from a list rather than to score against a profile. Two audio judges answer; both hearing one scores 0, neither scores 1, and a split goes to human review rather than into the denominator.",
      "required": [
        "inappropriate_present",
        "tones_heard",
        "rationale",
        "unjudgeable",
        "unjudgeable_reason"
      ],
      "properties": {
        "inappropriate_present": {
          "type": "boolean"
        },
        "tones_heard": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "unjudgeable": {
          "type": "boolean"
        },
        "unjudgeable_reason": {
          "type": "string"
        }
      }
    }
  }
}
