{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v6 content rubric, one condition",
  "description": "One rubric per (item, vocalization condition), written from that condition alone. There is no contrastive field: a requirement that exists only to differ from another version would be an artefact of the writer having seen it. Whether the two conditions' rubrics actually differ is a measurement taken afterwards, not a constraint imposed here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_id",
    "condition",
    "vocalization",
    "ambiguity_flag",
    "ambiguity_note",
    "review_note",
    "contextual_interpretation",
    "primary_response_function",
    "required_content",
    "acceptable_variations",
    "must_avoid",
    "reference_response"
  ],
  "properties": {
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "condition": {
      "type": "string",
      "enum": [
        "condition_a",
        "condition_b"
      ]
    },
    "vocalization": {
      "type": "string",
      "minLength": 1
    },
    "ambiguity_flag": {
      "type": "boolean"
    },
    "ambiguity_note": {
      "type": "string"
    },
    "review_note": {
      "type": "string"
    },
    "contextual_interpretation": {
      "type": "string",
      "minLength": 1
    },
    "primary_response_function": {
      "type": "string",
      "minLength": 1
    },
    "required_content": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "two independently checkable semantic requirements"
    },
    "acceptable_variations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "two alternative strategies meeting the same goal"
    },
    "must_avoid": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "two content-level mistakes"
    },
    "reference_response": {
      "type": "string",
      "minLength": 1
    }
  }
}
