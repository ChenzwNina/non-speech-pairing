{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v6 response guides, one per interpretation",
  "description": "What the other speaker's reply should accomplish under each interpretation, one guide per interpretation. `required_content` carries only what the vocalization obliges — the adaptation a reply has to make because the sound was there rather than nothing. Next actions, topics and volunteered details go in `acceptable_variations`: requiring them marks down replies that heard the sound correctly and simply said less.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_id",
    "condition",
    "vocalization",
    "responder",
    "guides"
  ],
  "properties": {
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "condition": {
      "type": "string",
      "enum": [
        "condition_a",
        "condition_b"
      ]
    },
    "vocalization": {
      "type": "string",
      "minLength": 1
    },
    "responder": {
      "type": "string",
      "enum": [
        "A",
        "B"
      ]
    },
    "guides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "interpretation_index",
          "response_function",
          "required_content",
          "acceptable_variations",
          "must_avoid",
          "example",
          "note"
        ],
        "properties": {
          "interpretation_index": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ]
          },
          "response_function": {
            "type": "string",
            "minLength": 1
          },
          "required_content": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "only what the sound obliges"
          },
          "acceptable_variations": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "natural continuations, not required"
          },
          "must_avoid": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "ways of misreading the sound"
          },
          "example": {
            "type": "string",
            "minLength": 1,
            "description": "human inspection only; never a similarity target"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
