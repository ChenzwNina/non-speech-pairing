          "seconds": 0.36
        },
        {
          "kind": "line",
          "turn": 2,
          "speaker": "John",
          "text": "You actually opened that box? You've been moving it around the kitchen for months.",
          "seconds": 5.76,
          "path": "soda_scatter/dataset/lines/soda_3209138/02_john.mp3",
          "vocalization": null,
          "starts_at_seconds": 8.12,
