        {
          "kind": "gap",
          "seconds": 0.36
        },
        {
          "kind": "line",
          "turn": 8,
          "speaker": "John",
          "text": "Yes. Giving the map away lands well, especially when you mention the club's thank-you note.",
          "seconds": 5.92,
          "path": "soda_scatter/dataset/lines/soda_3209138/08_john.mp3",
          "vocalization": null,
