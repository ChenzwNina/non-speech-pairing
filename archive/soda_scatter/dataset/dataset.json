        },
        {
          "kind": "gap",
          "seconds": 0.36
        },
        {
          "kind": "line",
          "turn": 7,
          "speaker": "Aminah",
          "text": "[warm laughter] You are supposed to be proofreading, not turning my comments section into a puddle. Did the ending work?",
          "seconds": 7.28,
          "path": "soda_scatter/dataset/lines/soda_3209138/07_aminah.mp3",
          "vocalization": "laughter",
