      "segments": [
        {
          "kind": "line",
          "turn": 1,
          "speaker": "Aminah",
          "text": "I finally finished my blog post about today—the library book sale, the rain, and finding Dad's old map in the donation box.",
          "seconds": 7.76,
          "path": "soda_scatter/dataset/lines/soda_3209138/01_aminah.mp3",
