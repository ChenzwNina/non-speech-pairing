          "kind": "gap",
          "seconds": 0.36
        },
        {
          "kind": "line",
          "turn": 6,
          "speaker": "John",
          "text": "[moved sob] That line got me. It lets him be present without pretending nothing has changed.",
          "seconds": 8.32,
          "path": "soda_scatter/dataset/lines/soda_3209138/06_john.mp3",
          "vocalization": "sob",
          "starts_at_seconds": 37.56,
